{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // OpenHarmony 编译类型：oniro 模拟器等纯 OpenHarmony 系统对 HarmonyOS 编译的
        // 包强制 fs-verity 代码签名（缺 fs-verity 的系统装不上）；OpenHarmony 类型无此要求
        "compatibleSdkVersion": 12,
        "compileSdkVersion": 21,
        "runtimeOS": "OpenHarmony",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
